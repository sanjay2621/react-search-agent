OPENAI_API_KEY=sk-your-key-here
TAVILY_API_KEY=tvly-your-key-here

# LangSmith tracing (optional) — https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=react-search-agent

# Only for LangSmith agent-addressed runs. Both must be set together,
# or every tracer callback fails. Leave commented out for plain tracing.
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=
